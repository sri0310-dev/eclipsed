# Microsoft Azure App Registration (Personal Microsoft Account)
# Register at https://portal.azure.com > App registrations
# Set "Supported account types" to include personal Microsoft accounts
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here

# Use "consumers" for personal Microsoft accounts, or "common" for both personal + org
AZURE_TENANT_ID=consumers

# OneDrive Excel file configuration
# After authenticating, use "Shared With Me" to find the file your colleague shared
# Copy the composite ID (format: driveId:itemId) for shared files
ONEDRIVE_FILE_ID=your_excel_file_id_here
ONEDRIVE_WORKSHEET_NAME=Sheet1
