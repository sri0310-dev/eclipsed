# Microsoft Azure AD / Entra ID Configuration
# Register an app at https://portal.azure.com > App registrations
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
AZURE_TENANT_ID=your_tenant_id_here

# The redirect URI registered in Azure AD (must match exactly)
AZURE_REDIRECT_URI=http://localhost:3000/api/onedrive/auth/callback

# OneDrive Excel file configuration
ONEDRIVE_FILE_ID=your_excel_file_id_here
ONEDRIVE_WORKSHEET_NAME=Sheet1

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
